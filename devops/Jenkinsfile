// EJERCICIO 12: Importar la librería compartida de Jenkins
@Library('iac-devops-lib') _

pipeline {
  agent any

  // EJERCICIO 6.3: Parámetros para activar/desactivar el CD
  parameters {
    booleanParam(name: 'RUN_CD', defaultValue: false, description: 'Ejecutar CD')
    // EJERCICIO 7: Parámetro para push al registry
    booleanParam(name: 'ENABLE_REGISTRY_PUSH', defaultValue: false, description: 'Subir imagen al registry privado')
    // EJERCICIO 9: Parámetro para subir a Artifactory
    booleanParam(name: 'ENABLE_ARTIFACTORY_UPLOAD', defaultValue: false, description: 'Subir JAR a Artifactory')
  }

  // Se define la variable global para la imagen de herramientas
  environment {
    CI_IMAGE_NAME = "java-ci-tools:${env.BUILD_NUMBER}"
    // EJERCICIO 6.4: Variables de entorno globales
    APP_URL = "http://localhost:8084/hello" // Puerto de la app Java
  }

  stages {
    // EJERCICIO 12: Usar readVersion para cargar variables de forma dinámica
    stage('Info & Setup') {
      steps {
        script {
          echo "Job: ${env.JOB_NAME}"
          echo "Build: ${env.BUILD_NUMBER}"
          
          // Leer versión desde el archivo VERSION en la raíz del repo de Java
          env.APP_VERSION = devopsLib.readVersion('VERSION')
          env.IMAGE_NAME = "contrerasadr/devops-training-java-app:${env.APP_VERSION}"
          env.REGISTRY_IMAGE = "local-registry:5000/${env.IMAGE_NAME}"
          
          echo "Versión de la App Java cargada: ${env.APP_VERSION}"
        }
      }
    }

    // EJERCICIO 3: Construir imagen CI con make (para Java)
    stage('CI - Build tools image') {
      steps {
        script {
          echo 'Construyendo la imagen Docker de herramientas CI para Java...'
          docker.build(env.CI_IMAGE_NAME, "-f devops/ci.Dockerfile .")
        }
      }
    }

    // EJERCICIO 3: Stage separado para Lint
    stage('CI - Lint') {
      steps {
        script {
          // EJERCICIO 12: Usar función de la librería compartida
          devopsLib.runInDocker(env.CI_IMAGE_NAME) {
            echo 'Ejecutando revisión de formato de código (Lint)...'
            sh 'make lint'
          }
        }
      }
    }

    // EJERCICIO 3: Stage separado para Test
    stage('CI - Test') {
      steps {
        script {
          // EJERCICIO 12: Usar función de la librería compartida
          devopsLib.runInDocker(env.CI_IMAGE_NAME) {
            echo 'Ejecutando tests unitarios con Maven...'
            sh 'make test'
          }
        }
      }
    }

    // EJERCICIO 9: Subir JAR a Artifactory
    stage('CI - Upload jar (opcional)') {
      when {
        expression { return params.ENABLE_ARTIFACTORY_UPLOAD }
      }
      steps {
        script {
          echo "Empaquetando la aplicación Java..."
          // EJERCICIO 12: Usar función de la librería compartida
          devopsLib.runInDocker(env.CI_IMAGE_NAME) {
            sh 'mvn -q -DskipTests package'
          }
          
          echo "Subiendo el JAR a Artifactory con curl..."
          withCredentials([usernamePassword(credentialsId: 'artifactory-creds', passwordVariable: 'ART_PASS', usernameVariable: 'ART_USER')]) {
            sh '''
              ART_URL="http://artifactory:8081/artifactory"
              ART_REPO="libs-release-local"
              ART_PATH="devops-training-java-app/${BUILD_NUMBER}"
              JAR_FILE=$(ls target/*.jar | head -n 1)
              
              curl -u "${ART_USER}:${ART_PASS}" -T "${JAR_FILE}" \
                "${ART_URL}/${ART_REPO}/${ART_PATH}/$(basename ${JAR_FILE})"
            '''
          }
        }
      }
    }

    // EJERCICIO 5: Construir la imagen Docker en CI
    stage('Build image') {
      steps {
        script {
          echo "Construyendo la imagen Docker de la aplicación Java..."
          docker.build(env.IMAGE_NAME, "--build-arg VERSION=0.0.1 -f devops/Dockerfile .")
        }
      }
    }

    // EJERCICIO 7: Push a un registry privado
    stage('Push image') {
      when {
        expression { return params.ENABLE_REGISTRY_PUSH }
      }
      steps {
        script {
          echo "Etiquetando la imagen Java para el registry local..."
          sh "docker tag ${env.IMAGE_NAME} ${env.REGISTRY_IMAGE}"
          
          echo "Autenticando y subiendo al registry..."
          withCredentials([usernamePassword(credentialsId: 'local-registry-creds', passwordVariable: 'REG_PASS', usernameVariable: 'REG_USER')]) {
            sh "docker login -u ${REG_USER} -p ${REG_PASS} local-registry:5000"
            sh "docker push ${env.REGISTRY_IMAGE}"
          }
        }
      }
    }

    // EJERCICIOS 6 al 6.5: CD con despliegue local y limpieza
    stage('CD') {
      // EJERCICIO 6.1: Condición de ejecución
      when {
        anyOf {
          expression { return params.RUN_CD }
          branch 'develop'
          branch 'master'
        }
      }
      steps {
        script {
          // EJERCICIO 6.2: Simular entorno DEV/PRO
          env.DEPLOY_ENV = (env.BRANCH_NAME == 'master') ? 'pro' : 'dev'
          echo "Deploying to ${env.DEPLOY_ENV}"

          // EJERCICIO 12: Actualizar el docker-compose.yml con la imagen nueva
          devopsLib.setComposeServiceImage(
            composeFile: 'docker-compose.yml',
            service: 'app',
            image: env.IMAGE_NAME
          )
          
          // EJERCICIO 12: Usar la función de CD de la librería compartida
          devopsLib.composeUpTestDown(
            up: "docker compose -p ${env.DEPLOY_ENV} up -d && sleep 5",
            test: "echo URL=${env.APP_URL} && docker compose -p ${env.DEPLOY_ENV} logs app",
            down: "docker compose -p ${env.DEPLOY_ENV} down --volumes"
          )
        }
      }
      // EJERCICIO 6.5: Hooks de limpieza
      post {
        always {
          sh "docker rmi ${env.IMAGE_NAME} || true"
        }
        success {
          echo 'SUCCESS'
        }
        failure {
          echo 'FAILURE'
        }
      }
    }
  }
}
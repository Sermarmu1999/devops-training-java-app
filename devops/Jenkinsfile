// EJERCICIO 4: Función Groovy reutilizable
def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()
    }
}

pipeline {
  agent any

  // EJERCICIO 6.3: Parámetros para activar/desactivar el CD
  parameters {
    booleanParam(name: 'RUN_CD', defaultValue: false, description: 'Ejecutar CD')
    // EJERCICIO 7: Parámetro para push al registry
    booleanParam(name: 'ENABLE_REGISTRY_PUSH', defaultValue: false, description: 'Subir imagen al registry privado')
  }

  // Se define la variable global para la imagen de herramientas
  environment {
    CI_IMAGE_NAME = "java-ci-tools:${env.BUILD_NUMBER}"
    // EJERCICIO 5: Variable con el nombre de la imagen final
    IMAGE_NAME = "contrerasadr/devops-training-java-app:0.0.1"
    // EJERCICIO 6.4: Variables de entorno globales
    APP_URL = "http://localhost:8084/hello" // Puerto de la app Java
    // EJERCICIO 7: Variable con la ruta del registry local para Java
    REGISTRY_IMAGE = "local-registry:5000/contrerasadr/devops-training-java-app:${env.BUILD_NUMBER}"
  }

  stages {
    // EJERCICIO 1: Estructura básica e Información
    stage('Info') {
      steps {
        echo "Job: ${env.JOB_NAME}"
        echo "Build: ${env.BUILD_NUMBER}"
      }
    }

    // EJERCICIO 3: Construir imagen CI con make (para Java)
    stage('CI - Build tools image') {
      steps {
        script {
          echo 'Construyendo la imagen Docker de herramientas CI para Java...'
          docker.build(env.CI_IMAGE_NAME, "-f devops/ci.Dockerfile .")
        }
      }
    }

    // EJERCICIO 3: Stage separado para Lint
    stage('CI - Lint') {
      steps {
        script {
          // EJERCICIO 4: Uso de la función Groovy
          runInDocker(env.CI_IMAGE_NAME) {
            echo 'Ejecutando revisión de formato de código (Lint)...'
            sh 'make lint'
          }
        }
      }
    }

    // EJERCICIO 3: Stage separado para Test
    stage('CI - Test') {
      steps {
        script {
          // EJERCICIO 4: Uso de la función Groovy
          runInDocker(env.CI_IMAGE_NAME) {
            echo 'Ejecutando tests unitarios con Maven...'
            sh 'make test'
          }
        }
      }
    }

    // EJERCICIO 5: Construir la imagen Docker en CI
    stage('Build image') {
      steps {
        script {
          echo "Construyendo la imagen Docker de la aplicación Java..."
          docker.build(env.IMAGE_NAME, "--build-arg VERSION=0.0.1 -f devops/Dockerfile .")
        }
      }
    }

    // EJERCICIO 7: Push a un registry privado
    stage('Push image') {
      when {
        expression { return params.ENABLE_REGISTRY_PUSH }
      }
      steps {
        script {
          echo "Etiquetando la imagen Java para el registry local..."
          sh "docker tag ${env.IMAGE_NAME} ${env.REGISTRY_IMAGE}"
          
          echo "Autenticando y subiendo al registry..."
          withCredentials([usernamePassword(credentialsId: 'local-registry-creds', passwordVariable: 'REG_PASS', usernameVariable: 'REG_USER')]) {
            sh "docker login -u ${REG_USER} -p ${REG_PASS} local-registry:5000"
            sh "docker push ${env.REGISTRY_IMAGE}"
          }
        }
      }
    }

    // EJERCICIOS 6 al 6.5: CD con despliegue local y limpieza
    stage('CD') {
      // EJERCICIO 6.1: Condición de ejecución
      when {
        anyOf {
          expression { return params.RUN_CD }
          branch 'develop'
          branch 'master'
        }
      }
      steps {
        script {
          // EJERCICIO 6.2: Simular entorno DEV/PRO
          env.DEPLOY_ENV = (env.BRANCH_NAME == 'master') ? 'pro' : 'dev'
          echo "Deploying to ${env.DEPLOY_ENV}"
          echo "CD habilitado: RUN_CD=${params.RUN_CD}, branch=${env.BRANCH_NAME}"
          
          // EJERCICIO 6: Docker Compose Up -> Logs
          echo 'Iniciando despliegue local con Docker Compose...'
          sh "docker compose -p ${env.DEPLOY_ENV} up -d"
          
          echo 'Esperando 5 segundos a que levante el servicio...'
          sh 'sleep 5'
          
          sh "echo URL=${env.APP_URL}"
          
          echo 'Mostrando logs del contenedor principal...'
          sh "docker compose -p ${env.DEPLOY_ENV} logs app"
        }
      }
      // EJERCICIO 6.5: Hooks de limpieza
      post {
        always {
          echo 'Ejecutando limpieza de recursos temporales...'
          sh "docker compose -p ${env.DEPLOY_ENV} down --volumes || true"
        }
        success {
          echo 'SUCCESS'
        }
        failure {
          echo 'FAILURE'
          sh "docker compose -p ${env.DEPLOY_ENV} logs || true"
        }
      }
    }
  }
}